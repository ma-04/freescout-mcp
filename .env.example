# Base URL of your FreeScout install (include a sub-path if FreeScout lives under one).
FREESCOUT_URL=https://support.example.com

# Option A (preferred): the raw Cookie header from a logged-in browser session.
# Copy laravel_session (named freescout_session on some installs) and, most importantly,
# the remember_web_<hash> cookie (only present if you ticked "Remember Me" at login).
# Format: name=value pairs separated by "; ".
FREESCOUT_COOKIE=laravel_session=eyJpdiI6...; remember_web_59ba36addc2b2f9401580f014c7f58ea4e30989d=eyJpdiI6...

# Option B (and/or): credentials for automatic (re)login when the cookie expires.
# Read from the environment only; never logged.
FREESCOUT_USER=agent@example.com
FREESCOUT_PASSWORD=

# Set to 1 to allow a plain http:// FREESCOUT_URL to a host other than localhost/127.0.0.1
# (the cookie and password would travel unencrypted). Refused by default.
# FREESCOUT_ALLOW_INSECURE=1

# Per-request timeout in milliseconds (default 30000).
FREESCOUT_TIMEOUT_MS=30000

# Pause in ms between consecutive ticket_volume searches (default 200; 0 = none). Each FreeScout
# search also runs a customer search on the server, so keep a pause against production.
# FREESCOUT_STATS_DELAY_MS=200

# debug | info | warn | error (stderr only; secrets are redacted). Default info.
FREESCOUT_LOG_LEVEL=info

# Tests only: ssh target of the demo host; enables DB checks (threads.type, send_logs) in
# test/integration-tools.test.ts. Not used by the server.
# FREESCOUT_DEMO_SSH=user@demo-host
