# ~/freescout-mcp/.env on the server (chmod 600). Never commit the real file.

# Bearer token every MCP client must send (Authorization: Bearer ...). Generate with:
#   openssl rand -hex 32
MCP_TOKEN=

# The FreeScout this server talks to. Clients cannot choose another one.
FREESCOUT_URL=https://support.example.com/

# Host IP the container port is published on: the machine's Tailscale IP (tailscale ip -4).
BIND_IP=100.64.0.1
# Host port (the container always listens on 8787).
MCP_PORT=8787

# Optional
# MCP_SESSION_TTL_MS=1800000
# MCP_MAX_SESSIONS=100
# FREESCOUT_TIMEOUT_MS=30000
# FREESCOUT_LOG_LEVEL=info

# Forwarding (forward_conversation). Unset = the tool does not exist. When set, the tool is registered for every
# session and may email ONLY these recipients: exact addresses and/or @domain (that domain only, no subdomains).
# @domain entries cannot be free-mail providers (@gmail.com, @outlook.com, ...) or public suffixes (@co.uk, ...);
# the server refuses to start. List exact addresses on those domains instead.
# FREESCOUT_FORWARD_ALLOW=ops@example.com,@team.example.com
